# Base URL of the NetFlow API server.
# Defaults to the deployed Render backend when unset (see src/utils/api.js).
# For local development against a local server, use: http://localhost:5000
VITE_API_URL=http://localhost:5000

# BaseLayer DMS web UI (optional) — powers "Open in DMS" on attachments.
# VITE_DMS_WEB_URL=https://your-dms-frontend.example
# local: VITE_DMS_WEB_URL=http://localhost:5173

