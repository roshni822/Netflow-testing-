          "sourceRegions": {
            "kind": "array",
            "default": [],
            "items": {
              "kind": "object",
              "fields": {
                "lineId": {
                  "kind": "string",
                  "required": true
                },
                "page": {
                  "kind": "number",
                  "required": true
                },
                "x": {
                  "kind": "number",
                  "required": true
                },
                "y": {
                  "kind": "number",
                  "required": true
                },
                "width": {
                  "kind": "number",
                  "required": true
                },
                "height": {
                  "kind": "number",
                  "required": true
                },
                "text": {
                  "kind": "string",
                  "default": ""
                },
                "confidence": {
                  "kind": "number",
                  "default": 0
                }
              }
            }
          }
        }
      }
    },
    "summary.high": {
      "kind": "number",
      "default": 0
    },
    "summary.medium": {
      "kind": "number",
      "default": 0
    },
    "summary.low": {
      "kind": "number",
      "default": 0
    },
    "errorCode": {
      "kind": "string",
      "default": null
