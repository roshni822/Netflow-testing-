      "enum": [
        "authenticated",
        "public"
      ]
    },
    "languageMode": {
      "kind": "string",
      "enum": [
        "english",
        "english_hindi",
        "hindi"
      ],
      "default": "english_hindi"
    },
    "accessTokenHash": {
      "kind": "string",
      "hidden": true,
      "default": null
    },
    "sourceFile.filename": {
      "kind": "string",
      "required": true
    },
    "sourceFile.mimetype": {
      "kind": "string",
      "default": "application/pdf"
    },
    "sourceFile.size": {
      "kind": "number",
      "required": true
    },
    "sourceFile.storage": {
      "kind": "string",
      "required": true,
      "enum": [
        "local",
        "dms",
        "s3"
      ]
    },
    "sourceFile.path": {
      "kind": "string",
      "default": null
