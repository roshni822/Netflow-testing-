{
  "name": "DocumentExtractionJob",
  "collection": "documentextractionjobs",
  "timestamps": true,
  "fields": {
    "orgId": {
      "kind": "id",
      "ref": "Organization",
      "required": true
    },
    "formId": {
      "kind": "id",
      "ref": "Form",
      "required": true
