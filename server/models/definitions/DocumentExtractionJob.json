              "number",
              "date",
              "numeric_identifier",
              "alphanumeric_identifier",
              "identifier_list",
              "text"
            ],
            "default": "text"
          },
          "valid": {
            "kind": "boolean",
            "default": false
          },
          "validationMessage": {
            "kind": "string",
            "default": null
