    "consumedAt": {
      "kind": "date",
      "default": null
    },
    "feedbackProcessedAt": {
      "kind": "date",
      "default": null
    },
    "feedbackResponseId": {
      "kind": "id",
      "ref": "FormResponse",
      "default": null
    },
    "expiresAt": {
      "kind": "date",
      "required": true
