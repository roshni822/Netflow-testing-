          "confidence": {
            "kind": "number",
            "min": 0,
            "max": 100,
            "default": 0
          },
          "tier": {
            "kind": "string",
            "required": true,
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "generatorConfidence": {
            "kind": "number",
            "min": 0,
            "max": 100,
            "default": 0
