{
  "name": "flowsphere-server",
  "version": "1.0.0",
  "description": "NetFlow backend - Node.js, Express and PostgreSQL.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:postgres": "node scripts/postgresSetup.js",
    "db:fresh": "node scripts/freshDatabaseSetup.js",
    "db:tenant": "node scripts/tenantRecovery.js",
    "test:postgres:schemas": "node tests/postgres/organizationSchemas.test.js",
    "test:postgres": "node tests/postgres/fresh.test.js",
    "smoke:dms": "node scripts/smokeTestDmsIntegration.js",
    "test:perm": "node tests/permissions.test.js",
    "test:adm": "node tests/admin_users.test.js",
    "test:pdf-autofill": "node tests/pdf_autofill.test.js",
    "test:document-form": "node tests/document_form_llm_first.test.js && node tests/document_candidate_audit.test.js && node tests/document_evidence_batches.test.js && node tests/document_review_routes.test.js",
    "test:platform-integrations": "node tests/platform_integration_validation.test.js",
    "test:llm": "node tests/llm_failover.test.js",
    "test:prf": "node tests/profile.test.js",
    "test:tsk": "node tests/tasks_approvals.test.js",
    "test:wfb": "node tests/workflow_engine.test.js",
    "test:ntf": "node tests/notifications.test.js",
    "test:ana": "node tests/analytics_audit.test.js",
    "test:plat": "node tests/platform_orgs.test.js",
    "test:edg": "node tests/edge_security.test.js",
    "test:hooks": "node tests/hooks_inbound.test.js",
    "test:licu": "node tests/licensing_unit.test.js",
    "test:lic": "node tests/licensing.test.js",
    "test:licq": "node tests/licensing_quota.test.js",
    "test:licusage": "node tests/licensing_usage.test.js",
    "test:storage": "node tests/storage_usage.test.js",
    "test:ui:perm": "node tests/ui_permissions.test.js",
    "test:ui:adm": "node tests/ui_admin.test.js",
    "test:ui:prf": "node tests/ui_profile.test.js",
    "test:ui:tsk": "node tests/ui_tasks.test.js",
    "test:ui:wfb": "node tests/ui_workflows.test.js",
    "test:ui:ntf": "node tests/ui_notifications.test.js",
    "test:ui:ana": "node tests/ui_analytics.test.js",
    "test:ui:plat": "node tests/ui_platform.test.js",
    "test:ui:platform-integrations": "node tests/ui_platform_integrations.test.js",
    "test:all": "node tests/runAll.js",
    "db:bootstrap": "node scripts/postgresSetup.js bootstrap",
    "test:security": "node tests/session_auth.test.js && node tests/release_security.test.js",
    "test:postgres:provisioning": "node tests/postgres/provisioning.test.js"
  },
  "keywords": [
    "flowsphere",
    "workflow",
    "approvals",
    "express",
    "postgresql"
  ],
  "author": "NetFlow Team",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/s3-request-presigner": "^3.1106.0",
    "@azure/msal-node": "^5.4.0",
    "ajv": "^8.20.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.3.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "mupdf": "^1.28.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.7",
    "pdfkit": "^0.19.1",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^6.0.0",
    "speakeasy": "^2.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "playwright": "^1.62.0"
  }
